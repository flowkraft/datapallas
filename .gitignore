## Windows detritus
#############

# Windows image file caches
Thumbs.db
ehthumbs.db

# Literal "nul" file created when tools redirect to /dev/null on Windows
nul

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

.aider*
_ai_crew_chat_with*
.workspace-*
.claude/

Dockerfile.assembled

# Secrets-encryption key for SecretsCipher. Generated per install on first use --
# shipping one would give every download the same key, so it must never be committed.
**/config/_internal/.master-key
**/config/_internal/api-key.txt

# ---------------------------------------------------------------------------
# Secrets. This repository is PUBLIC: a credential committed here is published
# the moment it is pushed, and rewriting history does not un-publish it. These
# rules are the last line of defence behind "never `git add -A` blindly".
#
# Already-tracked files are NOT affected by these rules (git only ignores
# untracked paths), so the shipped db-template samples keep working; what this
# stops is a NEW credential file being swept in by an unreviewed `git add -A`.
# ---------------------------------------------------------------------------

# CI connection / release settings - these live outside the repo, root-only
win-ci.env
release.env
*.release.env
demo-datapallas-com.env

# SSH and other private keys
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk
*_rsa
*_ed25519
!*.pub
*.pem
*.key
!**/i18n/*.key
*.p12
*.pfx
*.jks
*.keystore
*.asc
*.gpg
.netrc
_netrc

