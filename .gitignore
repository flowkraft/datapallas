#################
## Global build artifact patterns for asbl (source-only folder)
#################
# Build output directories (anywhere in asbl)
asbl/**/build/
asbl/**/target/
asbl/**/out/
asbl/**/dist/

# Dependency/package manager directories
asbl/**/vendor/
asbl/**/node_modules/

# Cache directories
asbl/**/.cache/
asbl/**/.gradle/
asbl/**/.parcel-cache/
asbl/**/.next/
asbl/**/.turbo/
asbl/**/__pycache__/

# Lock files (generated, not source)
asbl/**/composer.lock
asbl/**/package-lock.json
asbl/**/yarn.lock
asbl/**/pnpm-lock.yaml

# IDE/tool cache files
asbl/**/.php-cs-fixer.cache
asbl/**/.eslintcache
asbl/**/*.bladec

# OS artifacts
asbl/**/.DS_Store
asbl/**/Thumbs.db

# SQLite database files
asbl/**/*.db
asbl/**/*.db-shm
asbl/**/*.db-wal
*.db
*.db-shm
*.db-wal
# DuckDB database files (generated by NoExeAssembler at package time, not committed)
asbl/**/*.duckdb
*.duckdb

# WP-Bones generated files
asbl/**/bones
asbl/**/.bones_renamed

# asbl/docker holds build inputs the assembler reads, next to local scratch.
# Ignore the CONTENTS rather than the directory itself: git cannot re-include a
# file whose parent directory is excluded, so `asbl/docker` made every negation
# below unreachable and silently swallowed new files.
asbl/docker/*
!asbl/docker/docker-compose.yml
!asbl/docker/README.md
!asbl/docker/README-dockerhub.md
!asbl/docker/push-dockerhub-readme.ps1
!asbl/docker/datapallas.sh

#################
## CMS Webportal Playground - selective inclusion
#################
# First ignore everything in the playground directory
asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/*

# Unignore specific files
!asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/.env
!asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/docker-compose.yml
!asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/README.md

!asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/Dockerfile.cms-webportal
!asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/Dockerfile.wp-cli
!asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/Dockerfile.theme-builder
!asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/.dockerignore

# Unignore the wp-plugins directory itself
!asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/wp-plugins/

# IMMEDIATELY re-ignore all content inside wp-plugins
asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/wp-plugins/*

# Now ONLY unignore your specific plugin
!asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/wp-plugins/datapallas-portal/

# Unignore theme source but ignore build artifacts
!asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/wp-themes/datapallas-theme/
!asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/wp-themes/datapallas-theme/**
# Also ensure parent wp-themes directories are unignored so the theme can be tracked
!asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/wp-themes/
!asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/wp-themes/**
# Ignore build artifacts in theme
asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/wp-themes/datapallas-theme/**/dist/
asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/wp-themes/datapallas-theme/**/build/
asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/wp-themes/datapallas-theme/**/public/
asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/wp-themes/datapallas-theme/**/node_modules/
# Ignore built CSS files produced by Tailwind/esbuild
asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/wp-themes/datapallas-theme/**/style*.css
asbl/src/main/external-resources/db-template/_apps/cms-webportal-playground/wp-themes/datapallas-theme/**/style*.css.map

