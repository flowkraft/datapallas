# ============================================
# FlowKraft AI Crew - Environment Variables
# ============================================
# Copy this file to .env and customize for your environment

# ============================================
# Letta Configuration
# ============================================

# --- OpenAI ---
#OPENAI_API_KEY=

# --- Anthropic ---
#ANTHROPIC_API_KEY=

# --- Google Gemini ---
#GEMINI_API_KEY=

# --- Z.ai ---
#ZAI_API_KEY=

# --- OpenRouter.ai ---
#OPENROUTER_API_KEY=

# --- Other (OpenAI Compatible) ---
#OPENAI_API_KEY=
#OPENAI_API_BASE=

# --- Ollama (Local) ---
OLLAMA_BASE_URL=http://flowkraft-ai-hub-ollama:11434

# Selected model ID (set automatically by API Provider settings)
LLM_MODEL_ID=

AUTO_APPROVE_SHELL_COMMANDS=false
LETTA_DB_PASSWORD=letta

# ============================================
# Matrix/Synapse Database Configuration
# ============================================
DB_USER=synapse
DB_PASSWORD=synapse

# ============================================
# Code Server Configuration
# ============================================
CODE_SERVER_PASSWORD=admin

# ============================================
# Letta API Configuration
# ============================================
LETTA_API_KEY=

# ============================================
# Frontend Configuration
# ============================================
NEXT_PUBLIC_AGENTS_CHAT_URL=http://localhost:8441

# ============================================
# Volume Paths (optional - defaults to ./folders)
# ============================================
PROJECTS_FOLDER_PATH=./projects
AGENTS_HQ_FOLDER_PATH=./agents

# ============================================
# Baibot Configuration
# ============================================
BAIBOT_SEND_N_NEWEST_MESSAGES=1
BAIBOT_CONFIG_FILE_PATH=/app/config.yml
BAIBOT_PERSISTENCE_DATA_DIR_PATH=/data

# ============================================
# Matrix Provisioner Configuration
# ============================================
# Matrix/Synapse homeserver URL (internal Docker network)
MATRIX_HOMESERVER_URL=http://flowkraft-ai-hub-matrix-synapse:8008
# Matrix server name (domain for user IDs)
MATRIX_SERVER_NAME=localhost
# Shared secret from homeserver.yaml (for automated user creation)
# Must match registration_shared_secret in config/synapse/homeserver.yaml
MATRIX_REGISTRATION_SECRET=6180e53cc7b443e691d1bfc93c83bf2d60c8ee90a0db4bb194d74db52dd6f6cd

# ============================================
# DataPallas Backend
# ============================================
# Where the DataPallas backend is, AS SEEN FROM THIS CONTAINER. Needed because a container's own
# localhost is the container, not the host — the browser could use localhost:9090 only because the
# browser runs on the host.
#
# Never expose this as NEXT_PUBLIC_* — that would inline it into the browser bundle.
#
# This is the ONLY DataPallas setting the AI Hub needs. There is deliberately no API key and no
# auth flag: the app holds no credential of its own and forwards the caller's DataPallas session
# instead, so every request reaches the backend as the actual user with that user's roles. An API
# key here would authenticate as an administrator and turn this app into a way to act with more
# privilege than you hold. Holding nothing means there is nothing to leak or misconfigure.
DP_API_URL=http://host.docker.internal:9090/api
