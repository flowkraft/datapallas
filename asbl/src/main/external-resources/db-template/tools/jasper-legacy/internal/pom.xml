<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<groupId>com.flowkraft</groupId>
	<artifactId>jasper-legacy-runner</artifactId>
	<version>1.0.0</version>
	<packaging>jar</packaging>
	<name>DataPallas JasperReports 6 legacy runner</name>

	<description>
		Renders classic JRXML — the single format JasperReports used from 1.x through
		6.21 — which the JasperReports 7 engine inside DataPallas can no longer read.
		Deliberately kept in its own Docker image: JasperReports 6 pins openpdf 1.3.32
		and jfreechart 1.0.19, while DataPallas runs 1.3.43 and 1.5.6. The two sets
		cannot share a classpath, so they do not share a process.
	</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>

		<!-- Last release of the classic JasperReports line. -->
		<jasperreports.version>6.21.5</jasperreports.version>

		<!-- Only used by the optional REST service; the CLI never loads it. -->
		<spring-boot.version>3.3.5</spring-boot.version>

		<barcode4j.version>2.1</barcode4j.version>
		<zxing.version>3.4.0</zxing.version>
		<batik.version>1.19</batik.version>
		<xml-apis-ext.version>1.3.04</xml-apis-ext.version>

		<!-- JDBC drivers, at the versions DataPallas itself ships, so a report
			behaves the same here as it does in the main engine. -->
		<postgresql-jdbc.version>42.7.7</postgresql-jdbc.version>
		<mysql-jdbc.version>8.4.0</mysql-jdbc.version>
		<mariadb-jdbc.version>3.5.5</mariadb-jdbc.version>
		<mssql-jdbc.version>13.2.0.jre11</mssql-jdbc.version>
		<h2database.version>2.3.232</h2database.version>
		<sqlite-jdbc.version>3.49.1.0</sqlite-jdbc.version>
	</properties>

	<dependencies>

		<!-- The JasperReports 6 core is a monolith: charts, barcode components,
			crosstabs, the Groovy and JDT compilers, the classic XML loader, the OLAP
			and Hibernate query executers are all inside this one jar. That is exactly
			why a single 6.x runtime covers twenty years of templates. -->
		<dependency>
			<groupId>net.sf.jasperreports</groupId>
			<artifactId>jasperreports</artifactId>
			<version>${jasperreports.version}</version>
		</dependency>

		<!-- Font extension. Supplies DejaVu, the default font of most templates
			authored in Jaspersoft Studio. Without it any report naming it fails at
			fill time with JRFontNotFoundException. -->
		<dependency>
			<groupId>net.sf.jasperreports</groupId>
			<artifactId>jasperreports-fonts</artifactId>
			<version>${jasperreports.version}</version>
		</dependency>

		<!-- Barcodes. The components live in the core jar, but the renderer does
			not; without these a <c:Code128> element throws NoClassDefFoundError on
			org.krysalis.barcode4j.impl.AbstractBarcodeBean. -->
		<dependency>
			<groupId>net.sf.barcode4j</groupId>
			<artifactId>barcode4j</artifactId>
			<version>${barcode4j.version}</version>
			<exclusions>
				<!-- barcode4j 2.1 still lists its command-line and Ant-task extras.
					None are touched at fill time and Ant in particular must not be
					pulled in, so they stay out. -->
				<exclusion>
					<groupId>org.apache.ant</groupId>
					<artifactId>ant</artifactId>
				</exclusion>
				<exclusion>
					<groupId>commons-cli</groupId>
					<artifactId>commons-cli</artifactId>
				</exclusion>
				<exclusion>
					<groupId>avalon-framework</groupId>
					<artifactId>avalon-framework-impl</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.google.zxing</groupId>
			<artifactId>core</artifactId>
			<version>${zxing.version}</version>
		</dependency>

		<!-- Barcodes render as SVG by default, which is what pulls in Batik, and
			Batik in turn needs the SVG DOM interfaces from xml-apis-ext. Set
			net.sf.jasperreports.components.barcode4j.image.producer=image to render
			them as raster images and skip this whole branch. -->
		<dependency>
			<groupId>org.apache.xmlgraphics</groupId>
			<artifactId>batik-bridge</artifactId>
			<version>${batik.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.xmlgraphics</groupId>
			<artifactId>batik-svggen</artifactId>
			<version>${batik.version}</version>
		</dependency>
		<dependency>
			<groupId>xml-apis</groupId>
			<artifactId>xml-apis-ext</artifactId>
			<version>${xml-apis-ext.version}</version>
		</dependency>

		<!-- Drivers for the databases DataPallas ships support for and that may be
			redistributed. Oracle and DB2 are licence-restricted: put those jars in
			lib/ instead, where they are picked up the same way. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>${postgresql-jdbc.version}</version>
		</dependency>
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<version>${mysql-jdbc.version}</version>
		</dependency>
		<dependency>
			<groupId>org.mariadb.jdbc</groupId>
			<artifactId>mariadb-java-client</artifactId>
			<version>${mariadb-jdbc.version}</version>
		</dependency>
		<dependency>
			<groupId>com.microsoft.sqlserver</groupId>
			<artifactId>mssql-jdbc</artifactId>
			<version>${mssql-jdbc.version}</version>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<version>${h2database.version}</version>
		</dependency>
		<!-- SQLite: DataPallas's own sample database and every file-based SQLite
			connection. The file is reached through the db/ folder mounted at /work/db. -->
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<version>${sqlite-jdbc.version}</version>
		</dependency>

		<!-- The REST face of the same runner. Plain jars on a classpath, not a
			repackaged fat jar, so one image serves both modes: the default
			entrypoint is the CLI, and docker-compose overrides it to start this. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
			<version>${spring-boot.version}</version>
		</dependency>

	</dependencies>

	<build>
		<finalName>jasper-legacy-runner</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.6.1</version>
				<executions>
					<execution>
						<id>copy-dependencies</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/lib</outputDirectory>
							<includeScope>runtime</includeScope>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
