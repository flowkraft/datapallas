  {
    "id": "support-vs-last-year",
    "fromStory": 27,
    "question": "Tickets are up - is the desk keeping up? (this year against last)",
    "text": "**Show Me** opens the year so far - the **Opened** filter at the top - with **Tickets** and **Tickets Last Year** side by side, the breaches beside them, and **Priority** down the side. Last year is the same days one year back, and it moves with the filter: change the dates and both columns change together.",
    "query": {
      "dimensions": [
        "Priority"
      ],
      "measures": [
        "Tickets",
        "TicketsLastYear",
        "BreachedTickets",
        "BreachedTicketsLastYear"
      ],
      "filters": [
        {
          "member": "OpenedDate",
          "operator": "between",
          "values": [
            "{dataToday: startOf year}",
            "{dataToday}"
          ]
        }
      ]
    },
    "variants": [
      {
        "id": "by-month",
        "text": "Read **Opened** by **Month** instead of Priority: each month stands beside the same month a year earlier.",
        "query": {
          "dimensions": [
            "OpenedDate.month"
          ],
          "measures": [
            "Tickets",
            "TicketsLastYear",
            "BreachedTickets",
            "BreachedTicketsLastYear"
          ],
          "filters": [
            {
              "member": "OpenedDate",
              "operator": "between",
              "values": [
                "{dataToday: startOf year}",
                "{dataToday}"
              ]
            }
          ]
        }
      }
    ]
