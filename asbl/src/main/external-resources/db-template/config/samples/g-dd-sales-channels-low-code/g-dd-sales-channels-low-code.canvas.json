          "generatedSql": "SELECT \"channel\", CAST(AVG(CAST(\"total_amount\" AS DECIMAL(31,4))) AS DECIMAL(31,4)) AS \"total_amount_avg\", COUNT(\"order_id\") AS \"order_id_count\"\nFROM \"dash_demo\".\"orders\"\nWHERE \"status\" <> 'cancelled'\n  AND (${includeReturns} = TRUE OR \"status\" <> 'returned')\nGROUP BY \"channel\"\nORDER BY CASE WHEN CAST(AVG(CAST(\"total_amount\" AS DECIMAL(31,4))) AS DECIMAL(31,4)) IS NULL THEN 1 ELSE 0 END, CAST(AVG(CAST(\"total_amount\" AS DECIMAL(31,4))) AS DECIMAL(31,4)) DESC\nLIMIT 500",
