                  "label": "Revenue"
                }
              ]
            },
            "options": {
              "plugins": {
                "title": {
                  "display": true,
                  "text": "Revenue mix by channel"
                }
              }
            }
          },
          "grouped": true,
          "userPicked": true
        },
        "columns": [
          {
            "columnName": "channel",
            "typeName": "VARCHAR",
            "isNullable": true
          },
          {
            "columnName": "total_amount_sum",
            "typeName": "DOUBLE",
