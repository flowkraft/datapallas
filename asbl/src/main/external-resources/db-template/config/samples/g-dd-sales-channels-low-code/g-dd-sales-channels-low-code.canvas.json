        "gridPosition": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 1
        },
        "dataSource": null,
        "displayConfig": {
          "textContent": "## Sales Channels\n\nThe mobile app has grown from about 14% to about 28% of orders since 2024 while the marketplace has shrunk from 19% to 12%. Marketplace orders come back about twice as often as web orders (10.7% against 5.6%), and Smart Home sells mostly through the app."
        },
        "columns": null,
        "shape": null
      },
      {
        "id": "w-dd04-chart-revenue-mix-by-channel",
        "type": "chart",
        "gridPosition": {
          "x": 0,
          "y": 1,
          "w": 6,
          "h": 4
        },
        "dataSource": {
          "mode": "visual",
          "visualQuery": {
            "kind": "table",
            "table": "orders",
            "tableSchema": "dash_demo",
            "filters": [
              {
                "column": "status",
                "operator": "not_equals",
                "value": "cancelled"
              },
              {
                "column": "status",
                "operator": "not_equals",
                "value": "returned",
                "switchParam": "includeReturns",
                "switchOn": "off"
              }
            ],
            "summarize": [
              {
                "aggregation": "SUM",
                "field": "total_amount"
              },
              {
                "aggregation": "SUM",
                "field": "total_amount",
                "share": true
              }
            ],
            "groupBy": [
              "channel"
            ],
            "sort": [
              {
                "column": "total_amount_sum",
                "direction": "DESC"
              }
            ],
            "limit": 500,
            "groupByNumericBuckets": {},
            "groupByBuckets": {}
          },
          "generatedSql": "SELECT \"channel\", CAST(SUM(\"total_amount\") AS DECIMAL(31,4)) AS \"total_amount_sum\", (100.0 * CAST(CAST(SUM(\"total_amount\") AS DECIMAL(31,4)) AS DECIMAL(20,4)) / NULLIF(SUM(CAST(SUM(\"total_amount\") AS DECIMAL(31,4))) OVER (), 0)) AS \"total_amount_sum_pct\"\nFROM \"dash_demo\".\"orders\"\nWHERE \"status\" <> 'cancelled'\n  AND (${includeReturns} = TRUE OR \"status\" <> 'returned')\nGROUP BY \"channel\"\nORDER BY CASE WHEN CAST(SUM(\"total_amount\") AS DECIMAL(31,4)) IS NULL THEN 1 ELSE 0 END, CAST(SUM(\"total_amount\") AS DECIMAL(31,4)) DESC\nLIMIT 500",
          "rowsSql": "SELECT *\nFROM \"dash_demo\".\"orders\"\nWHERE \"status\" <> 'cancelled'\n  AND (${includeReturns} = TRUE OR \"status\" <> 'returned')\n  AND \"channel\" = ${__drill_channel}\nLIMIT 500",
          "rowsFields": [
            "channel"
          ],
          "sql": "SELECT \"channel\", CAST(SUM(\"total_amount\") AS DECIMAL(31,4)) AS \"total_amount_sum\", (100.0 * CAST(CAST(SUM(\"total_amount\") AS DECIMAL(31,4)) AS DECIMAL(20,4)) / NULLIF(SUM(CAST(SUM(\"total_amount\") AS DECIMAL(31,4))) OVER (), 0)) AS \"total_amount_sum_pct\"\nFROM \"dash_demo\".\"orders\"\nWHERE \"status\" <> 'cancelled'\n  AND (${includeReturns} = TRUE OR \"status\" <> 'returned')\nGROUP BY \"channel\"\nORDER BY CASE WHEN CAST(SUM(\"total_amount\") AS DECIMAL(31,4)) IS NULL THEN 1 ELSE 0 END, CAST(SUM(\"total_amount\") AS DECIMAL(31,4)) DESC\nLIMIT 500",
          "executeVersion": 1
        },
        "displayConfig": {
          "dslConfig": {
            "type": "pie",
            "data": {
              "labelField": "channel",
              "datasets": [
