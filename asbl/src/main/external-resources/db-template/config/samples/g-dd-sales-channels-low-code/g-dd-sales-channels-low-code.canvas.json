      {
        "id": "w-dd04-chart-channel-share-per-month",
        "type": "chart",
        "gridPosition": {
          "x": 0,
          "y": 5,
          "w": 12,
          "h": 4
        },
        "dataSource": {
          "mode": "sql",
          "visualQuery": {
            "kind": "table",
            "table": "orders",
            "tableSchema": "dash_demo",
            "filters": [],
            "summarize": [],
            "groupBy": [],
            "sort": [],
            "limit": 500
          },
          "sql": "SELECT date_trunc('month', o.order_ts) AS month,\n       o.channel AS channel,\n       round(100.0 * count(*)\n             / sum(count(*)) OVER (PARTITION BY date_trunc('month', o.order_ts)), 2) AS share_pct\nFROM dash_demo.orders o\nWHERE o.status <> 'cancelled'\n  AND (o.status <> 'returned' OR ${includeReturns})\nGROUP BY 1, 2\nORDER BY 1, 2",
          "executeVersion": 1
        },
        "displayConfig": {
