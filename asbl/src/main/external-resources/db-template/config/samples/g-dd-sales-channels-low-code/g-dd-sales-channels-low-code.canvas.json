      {
        "id": "w-dd04-sankey-channel-to-category",
        "type": "sankey",
        "gridPosition": {
          "x": 0,
          "y": 9,
          "w": 12,
          "h": 5
        },
        "dataSource": {
          "mode": "sql",
          "visualQuery": {
            "kind": "table",
            "table": "orders",
            "tableSchema": "dash_demo",
            "filters": [],
            "summarize": [],
            "groupBy": [],
            "sort": [],
            "limit": 500
          },
          "sql": "SELECT o.channel AS channel,\n       p.category AS category,\n       round(sum(l.line_amount), 2) AS revenue\nFROM dash_demo.orders o\nJOIN dash_demo.order_lines l ON l.order_id = o.order_id\nJOIN dash_demo.products p ON p.product_id = l.product_id\nWHERE o.status <> 'cancelled'\n  AND (o.status <> 'returned' OR ${includeReturns})\nGROUP BY 1, 2\nORDER BY revenue DESC",
          "executeVersion": 1
        },
