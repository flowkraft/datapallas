      {
        "id": "w-dd09-chart-customers-by-lifetime-orders",
        "type": "chart",
        "gridPosition": {
          "x": 6,
          "y": 8,
          "w": 6,
          "h": 5
        },
        "dataSource": {
          "mode": "sql",
          "visualQuery": {
            "kind": "table",
            "table": "orders",
            "tableSchema": "dash_demo",
            "filters": [],
            "summarize": [],
            "groupBy": [],
            "sort": [],
            "limit": 500
          },
          "sql": "SELECT b.bucket AS lifetime_orders,\n       count(*) AS customers\nFROM (SELECT CASE WHEN n.orders = 0 THEN 'none'\n                  WHEN n.orders = 1 THEN '1'\n                  WHEN n.orders <= 3 THEN '2-3'\n                  WHEN n.orders <= 5 THEN '4-5'\n                  WHEN n.orders <= 9 THEN '6-9'\n                  ELSE '10 or more' END AS bucket,\n             CASE WHEN n.orders = 0 THEN 0\n                  WHEN n.orders = 1 THEN 1\n                  WHEN n.orders <= 3 THEN 2\n                  WHEN n.orders <= 5 THEN 3\n                  WHEN n.orders <= 9 THEN 4\n                  ELSE 5 END AS sort_key\n      FROM (SELECT (SELECT count(*) FROM dash_demo.orders o\n                    WHERE o.customer_id = c.customer_id\n                      AND o.status <> 'cancelled') AS orders\n            FROM dash_demo.customers c\n            WHERE true\n              AND c.segment = ${segment}\n              AND c.acquisition_channel IN (${acquisitionChannel})\n           ) n\n     ) b\nGROUP BY 1, b.sort_key\nORDER BY b.sort_key",
          "executeVersion": 1
        },
        "displayConfig": {
