              },
              "order": [
                {
                  "member": "DeliveredAt",
                  "dir": "asc"
                }
              ],
              "limit": null,
              "paramBindings": [
                {
                  "param": "dateFrom",
                  "member": "DeliveredAt",
                  "operator": "greater_or_equal"
                },
                {
                  "param": "carrier",
                  "member": "Carrier",
                  "operator": "in"
                }
              ]
            }
          },
          "generatedSql": "SELECT\n  CAST(DATE_TRUNC('week', dash_demo.orders.delivered_ts) AS DATE) AS \"DeliveredAt\",\n  1.0 * ((COUNT(CASE WHEN (dash_demo.orders.delivered_ts IS NOT NULL) THEN 1 END)) - (COUNT(CASE WHEN (CAST(dash_demo.orders.delivered_ts AS DATE) > dash_demo.orders.promised_date) THEN 1 END))) / NULLIF((COUNT(CASE WHEN (dash_demo.orders.delivered_ts IS NOT NULL) THEN 1 END)), 0) AS \"OnTimePct\"\nFROM dash_demo.orders\nWHERE dash_demo.orders.delivered_ts < ${dateTo__next_day}\n  AND dash_demo.orders.delivered_ts >= ${dateFrom}\n  AND dash_demo.orders.carrier IN (${carrier})\nGROUP BY\n  CAST(DATE_TRUNC('week', dash_demo.orders.delivered_ts) AS DATE)\nORDER BY\n  \"DeliveredAt\" ASC"
