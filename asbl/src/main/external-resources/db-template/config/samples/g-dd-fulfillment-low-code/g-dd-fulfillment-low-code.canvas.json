      {
        "id": "w-dd20-map-late-by-country",
        "type": "map",
        "gridPosition": {
          "x": 0,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "dataSource": {
          "mode": "sql",
          "visualQuery": {
