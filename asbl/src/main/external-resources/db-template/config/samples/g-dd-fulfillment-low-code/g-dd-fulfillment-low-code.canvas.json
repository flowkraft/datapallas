            "cubeSelection": {
              "dimensions": [
                "DeliveredAt.week"
              ],
              "measures": [
                "OnTimePct"
              ],
              "segments": [],
              "filters": [
                {
                  "member": "DeliveredAt",
                  "operator": "lt",
                  "values": [
