          },
          "generatedSql": "SELECT CAST(AVG(CAST((CASE WHEN (\"purchased\" = TRUE) THEN 1 ELSE 0 END) AS DECIMAL(31,4))) AS DECIMAL(31,4)) AS \"conversion_avg\"\nFROM \"dash_demo\".\"web_sessions\"\nWHERE \"started_ts\" >= ${dateFrom} AND \"started_ts\" < ${dateTo__next_day}\n  AND \"device\" IN (${device})\nLIMIT 500",
          "sql": "SELECT CAST(AVG(CAST((CASE WHEN (\"purchased\" = TRUE) THEN 1 ELSE 0 END) AS DECIMAL(31,4))) AS DECIMAL(31,4)) AS \"conversion_avg\"\nFROM \"dash_demo\".\"web_sessions\"\nWHERE \"started_ts\" >= ${dateFrom} AND \"started_ts\" < ${dateTo__next_day}\n  AND \"device\" IN (${device})\nLIMIT 500",
