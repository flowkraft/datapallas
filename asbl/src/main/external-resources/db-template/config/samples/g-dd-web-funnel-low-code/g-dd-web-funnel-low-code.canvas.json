      {
        "id": "w-dd12-chart-funnel",
        "type": "chart",
        "gridPosition": {
          "x": 0,
          "y": 4,
          "w": 6,
          "h": 5
        },
        "dataSource": {
          "mode": "sql",
          "visualQuery": {
            "kind": "table",
            "table": "web_sessions",
            "tableSchema": "dash_demo",
            "filters": [],
            "summarize": [],
            "groupBy": [],
            "sort": [],
            "limit": 500
          },
          "sql": "WITH scope AS (\n  SELECT s.reached_product AS reached_product,\n         s.reached_cart AS reached_cart,\n         s.reached_checkout AS reached_checkout,\n         s.purchased AS purchased\n  FROM dash_demo.web_sessions s\n  WHERE true\n    AND s.started_ts >= ${dateFrom}\n    AND s.started_ts < ${dateTo__next_day}\n    AND s.device IN (${device})\n),\nsteps AS (\n  SELECT 1 AS ord, 'Session' AS step, count(*) AS sessions FROM scope\n  UNION ALL SELECT 2, 'Reached product', count(CASE WHEN reached_product THEN 1 END) FROM scope\n  UNION ALL SELECT 3, 'Reached cart', count(CASE WHEN reached_cart THEN 1 END) FROM scope\n  UNION ALL SELECT 4, 'Reached checkout', count(CASE WHEN reached_checkout THEN 1 END) FROM scope\n  UNION ALL SELECT 5, 'Purchased', count(CASE WHEN purchased THEN 1 END) FROM scope\n)\nSELECT step AS step,\n       sessions AS sessions,\n       round(100.0 * sessions / (SELECT max(sessions) FROM steps), 2) AS pct_of_sessions\nFROM steps\nORDER BY ord",
          "executeVersion": 1
        },
        "displayConfig": {
          "dslConfig": {
            "type": "funnel",
            "data": {
              "labelField": "step",
              "datasets": [
                {
                  "field": "sessions",
                  "label": "Sessions (sampled 1 in 8)"
                }
              ]
            },
            "options": {
              "plugins": {
                "title": {
                  "display": true,
                  "text": "Session to product to cart to checkout to purchase"
                }
              }
            }
          },
          "grouped": true,
          "userPicked": true
        },
        "columns": [
          {
            "columnName": "step",
            "typeName": "VARCHAR",
            "isNullable": true
          },
          {
            "columnName": "sessions",
            "typeName": "DOUBLE",
            "isNullable": true
          },
          {
            "columnName": "pct_of_sessions",
            "typeName": "DOUBLE",
            "isNullable": true
          }
        ],
        "shape": {
          "dims": [
            {
              "name": "step",
              "kind": "category-low",
              "isState": false,
              "isCountry": false,
              "isCoordinate": false
            }
          ],
          "measures": [
            {
              "name": "sessions",
              "kind": "measure"
            },
            {
              "name": "pct_of_sessions",
              "kind": "measure"
            }
          ]
        }
