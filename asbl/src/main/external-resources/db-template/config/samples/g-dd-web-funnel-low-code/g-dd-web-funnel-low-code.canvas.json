                "direction": "ASC"
              }
            ],
            "limit": 500,
            "groupByNumericBuckets": {},
            "groupByBuckets": {
              "started_ts": "week"
            }
          },
          "generatedSql": "SELECT *\nFROM (\n  SELECT strftime(\"started_ts\", '%G-W%V') AS \"started_ts\", COUNT(\"session_id\") AS \"session_id_count\"\n  FROM \"dash_demo\".\"web_sessions\"\n  WHERE \"started_ts\" >= ${dateFrom} AND \"started_ts\" < ${dateTo__next_day}\n    AND \"device\" IN (${device})\n  GROUP BY strftime(\"started_ts\", '%G-W%V')\n) grouped_rows\nORDER BY CASE WHEN \"started_ts\" IS NULL THEN 1 ELSE 0 END, \"started_ts\" ASC\nLIMIT 500",
          "sql": "SELECT *\nFROM (\n  SELECT strftime(\"started_ts\", '%G-W%V') AS \"started_ts\", COUNT(\"session_id\") AS \"session_id_count\"\n  FROM \"dash_demo\".\"web_sessions\"\n  WHERE \"started_ts\" >= ${dateFrom} AND \"started_ts\" < ${dateTo__next_day}\n    AND \"device\" IN (${device})\n  GROUP BY strftime(\"started_ts\", '%G-W%V')\n) grouped_rows\nORDER BY CASE WHEN \"started_ts\" IS NULL THEN 1 ELSE 0 END, \"started_ts\" ASC\nLIMIT 500",
