      {
        "id": "w-dd02-chart-revenue-per-month",
        "type": "chart",
        "gridPosition": {
          "x": 0,
          "y": 3,
          "w": 12,
          "h": 4
        },
        "dataSource": {
          "mode": "visual",
          "visualQuery": {
            "table": "orders",
            "tableSchema": "dash_demo",
            "filters": [
              {
                "column": "status",
                "operator": "not_equals",
                "value": "cancelled"
              },
              {
                "column": "order_ts",
                "operator": "between",
                "value": "${dateFrom}",
                "valueTo": "${dateTo}"
              },
              {
                "column": "country_code",
                "operator": "equals",
                "value": "${country}"
              },
              {
                "column": "channel",
                "operator": "in",
                "value": "${channel}"
              }
            ],
            "summarize": [
              {
                "aggregation": "SUM",
                "field": "total_amount"
              }
            ],
            "groupBy": [
              "order_ts"
            ],
            "sort": [
              {
                "column": "order_ts",
                "direction": "ASC"
              }
            ],
            "limit": 500,
            "groupByBuckets": {
              "order_ts": "month"
            }
          },
          "generatedSql": "SELECT *\nFROM (\n  SELECT strftime(\"order_ts\", '%Y-%m') AS \"order_ts\", CAST(SUM(\"total_amount\") AS DECIMAL(31,4)) AS \"total_amount_sum\"\n  FROM \"dash_demo\".\"orders\"\n  WHERE \"status\" <> 'cancelled'\n    AND \"order_ts\" >= ${dateFrom} AND \"order_ts\" < ${dateTo__next_day}\n    AND \"country_code\" = ${country}\n    AND \"channel\" IN (${channel})\n  GROUP BY strftime(\"order_ts\", '%Y-%m')\n) grouped_rows\nORDER BY CASE WHEN \"order_ts\" IS NULL THEN 1 ELSE 0 END, \"order_ts\" ASC\nLIMIT 500"
        },
        "displayConfig": {
          "dslConfig": {
            "type": "line",
            "data": {
              "labelField": "order_ts",
              "datasets": [
                {
                  "field": "total_amount_sum",
                  "label": "Revenue"
                }
              ]
            },
            "options": {
              "plugins": {
                "title": {
                  "display": true,
                  "text": "Revenue per month"
                }
              }
            }
          }
        },
        "columns": null,
        "shape": null
