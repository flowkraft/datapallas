      {
        "id": "w-dd02-chart-revenue-by-category",
        "type": "chart",
        "gridPosition": {
          "x": 0,
          "y": 7,
          "w": 6,
          "h": 4
        },
        "dataSource": {
          "mode": "sql",
          "sql": "SELECT p.category AS category,\n       ROUND(SUM(l.line_amount), 2) AS revenue\nFROM dash_demo.order_lines l\nJOIN dash_demo.orders o ON o.order_id = l.order_id\nJOIN dash_demo.products p ON p.product_id = l.product_id\nWHERE o.status <> 'cancelled'\n  AND o.order_ts >= ${dateFrom}\n  AND o.order_ts < ${dateTo__next_day}\n  AND o.country_code = ${country}\n  AND o.channel IN (${channel})\nGROUP BY p.category\nORDER BY revenue DESC"
        },
        "displayConfig": {
          "dslConfig": {
            "type": "row",
            "data": {
              "labelField": "category",
              "datasets": [
