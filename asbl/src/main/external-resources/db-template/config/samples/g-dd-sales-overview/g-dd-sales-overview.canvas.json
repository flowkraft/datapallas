              {
                "column": "status",
                "operator": "not_equals",
                "value": "cancelled"
              },
              {
                "column": "order_ts",
                "operator": "between",
                "value": "${dateFrom}",
                "valueTo": "${dateTo}"
              },
              {
                "column": "country_code",
                "operator": "equals",
                "value": "${country}"
              },
              {
                "column": "channel",
                "operator": "in",
                "value": "${channel}"
              }
            ],
            "summarize": [
              {
                "aggregation": "SUM",
                "field": "total_amount"
              }
            ],
            "groupBy": [],
            "sort": [],
            "limit": 1
          },
          "generatedSql": "SELECT CAST(SUM(\"total_amount\") AS DECIMAL(31,4)) AS \"total_amount_sum\"\nFROM \"dash_demo\".\"orders\"\nWHERE \"status\" <> 'cancelled'\n  AND \"order_ts\" >= ${dateFrom} AND \"order_ts\" < ${dateTo__next_day}\n  AND \"country_code\" = ${country}\n  AND \"channel\" IN (${channel})\nLIMIT 1"
