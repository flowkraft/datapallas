            "tableSchema": "dash_demo",
            "filters": [],
            "summarize": [],
            "groupBy": [],
            "sort": [],
            "limit": 500
          },
          "sql": "SELECT round(\n         (SELECT sum(c.amount) FROM dash_demo.crm_opportunities c\n          WHERE c.stage = 'won'\n            AND c.closed_date >= date_trunc('quarter', (SELECT a.as_of FROM dash_demo.as_of a))\n            AND c.closed_date <= (SELECT a.as_of FROM dash_demo.as_of a)\n            AND c.owner_employee_id = ${repEmployeeId}\n         )\n       / (SELECT sum(q.quota) FROM dash_demo.rep_quotas q\n          WHERE q.quarter_start = date_trunc('quarter', (SELECT a.as_of FROM dash_demo.as_of a))\n            AND q.employee_id = ${repEmployeeId}\n         ), 4) AS quota_attainment",
          "executeVersion": 1
        },
