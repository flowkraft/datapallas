      {
        "id": "w-dd07-gauge-quota-attainment",
        "type": "gauge",
        "gridPosition": {
          "x": 6,
          "y": 1,
          "w": 3,
          "h": 3
        },
        "dataSource": {
          "mode": "sql",
          "visualQuery": {
