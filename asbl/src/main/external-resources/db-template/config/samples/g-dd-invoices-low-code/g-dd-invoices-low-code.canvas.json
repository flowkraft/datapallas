          "generatedSql": "SELECT\n  dash_demo.customers.name AS \"Customer\",\n  CAST(SUM(dash_demo.invoices.amount + dash_demo.invoices.tax_amount) AS DECIMAL(31,4)) AS \"Billed\"\nFROM dash_demo.invoices\nLEFT JOIN dash_demo.customers ON dash_demo.invoices.customer_id = dash_demo.customers.customer_id\nWHERE (dash_demo.invoices.issue_date >= ${issuedFrom} AND dash_demo.invoices.issue_date <= ${issuedTo})\n  AND dash_demo.invoices.status IN (${status})\nGROUP BY\n  dash_demo.customers.name\nORDER BY\n  \"Billed\" DESC\nLIMIT 10"
