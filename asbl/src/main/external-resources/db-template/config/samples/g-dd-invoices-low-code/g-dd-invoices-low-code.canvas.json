      {
        "id": "w-dd13-chart-billed-per-month-by-status",
        "type": "chart",
        "gridPosition": {
          "x": 0,
          "y": 3,
          "w": 8,
          "h": 4
        },
        "dataSource": {
          "mode": "visual",
          "visualQuery": {
            "kind": "cube",
            "cubeId": "dd-finance",
            "table": "",
            "filters": [],
            "summarize": [],
            "groupBy": [],
            "sort": [],
            "limit": 500,
            "cubeSelection": {
              "dimensions": [
                "IssuedAt.month",
                "Status"
              ],
              "measures": [
                "Billed"
              ],
              "segments": [],
              "filters": [],
              "granularities": {
                "IssuedAt": "month"
              },
              "order": [
                {
                  "member": "IssuedAt",
                  "dir": "asc"
                },
                {
                  "member": "Status",
                  "dir": "asc"
                }
              ],
              "limit": 500,
              "paramBindings": [
                {
                  "param": "issuedFrom",
                  "member": "IssuedAt",
                  "operator": "between",
                  "paramTo": "issuedTo"
                },
                {
                  "param": "status",
                  "member": "Status",
                  "operator": "in"
                }
              ]
            }
          },
          "generatedSql": "SELECT\n  CAST(DATE_TRUNC('month', dash_demo.invoices.issue_date) AS DATE) AS \"IssuedAt\",\n  dash_demo.invoices.status AS \"Status\",\n  CAST(SUM(dash_demo.invoices.amount + dash_demo.invoices.tax_amount) AS DECIMAL(31,4)) AS \"Billed\"\nFROM dash_demo.invoices\nWHERE (dash_demo.invoices.issue_date >= ${issuedFrom} AND dash_demo.invoices.issue_date <= ${issuedTo})\n  AND dash_demo.invoices.status IN (${status})\nGROUP BY\n  CAST(DATE_TRUNC('month', dash_demo.invoices.issue_date) AS DATE),\n  dash_demo.invoices.status\nORDER BY\n  \"IssuedAt\" ASC,\n  \"Status\" ASC\nLIMIT 500"
        },
