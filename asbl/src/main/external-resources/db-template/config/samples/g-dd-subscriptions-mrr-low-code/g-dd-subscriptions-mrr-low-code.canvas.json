          "w": 12,
          "h": 1
        },
        "dataSource": null,
        "displayConfig": {
          "textContent": "## Subscriptions: MRR & Churn\n\nFebruary 2026 was the worst month of the year for retention - every cohort kept less of itself, and price is the reason 86 subscribers gave when they left - yet MRR is at a new high of 99,781.43, with 8,102.58 of it won back by expansion over the last 12 months.\n\nRecurring revenue from the top: where MRR is and which way it is going, how many subscribers carry it, and how many left last month. Then what moved MRR over the year and why people left; then which plans hold the revenue, and whether the price change hit the older cohorts as well as the new ones. Pick one or more **plans** to read a single price point: the price change did not hit every plan alike."
        },
        "columns": null,
        "shape": null
      },
      {
        "id": "w-dd15-trend-mrr",
        "type": "trend",
        "gridPosition": {
          "x": 0,
          "y": 1,
          "w": 5,
          "h": 3
        },
        "dataSource": {
          "mode": "sql",
          "visualQuery": {
            "kind": "table",
            "table": "as_of",
            "tableSchema": "dash_demo",
            "filters": [],
            "summarize": [],
            "groupBy": [],
            "sort": [],
            "limit": 500
          },
          "sql": "WITH months AS (\n  SELECT CAST(date_trunc('month', (SELECT a.as_of FROM dash_demo.as_of a)) - to_months(CAST(g.i AS INTEGER)) AS DATE) AS month\n  FROM generate_series(0, 11) AS g(i)\n),\nmonth_end AS (\n  SELECT month,\n         CAST(least(month + to_months(1) - to_days(1), (SELECT a.as_of FROM dash_demo.as_of a)) AS DATE) AS read_at\n  FROM months\n)\nSELECT m.month AS month,\n       round(sum(s.mrr), 2) AS mrr\nFROM month_end m\nJOIN dash_demo.subscriptions s\n  ON s.start_date <= m.read_at\n AND (s.cancel_date IS NULL OR s.cancel_date > m.read_at)\nWHERE true\n  AND s.plan IN (${plan})\nGROUP BY m.month\nORDER BY m.month",
          "executeVersion": 1
        },
        "displayConfig": {
          "dslConfig": {
            "type": "line",
            "data": {
              "labelField": "month",
              "datasets": [
                {
                  "field": "mrr",
                  "label": "mrr"
                }
              ]
            }
          },
          "dateField": "month",
          "_auto_dateField": true,
          "valueField": "mrr",
