      {
        "id": "w-dd15-gauge-churn-last-month",
        "type": "gauge",
        "gridPosition": {
          "x": 9,
          "y": 1,
          "w": 3,
          "h": 3
        },
        "dataSource": {
          "mode": "sql",
          "visualQuery": {
            "kind": "table",
            "table": "as_of",
            "tableSchema": "dash_demo",
            "filters": [],
            "summarize": [],
            "groupBy": [],
            "sort": [],
            "limit": 500
          },
          "sql": "SELECT round(count(*) FILTER (WHERE date_trunc('month', s.cancel_date) = date_trunc('month', (SELECT a.as_of FROM dash_demo.as_of a)))\n             / count(*)::DOUBLE, 4) AS churn_last_month\nFROM dash_demo.subscriptions s\nWHERE true\n  AND s.plan IN (${plan})\n  AND s.start_date < date_trunc('month', (SELECT a.as_of FROM dash_demo.as_of a))\n  AND (s.cancel_date IS NULL OR s.cancel_date >= date_trunc('month', (SELECT a.as_of FROM dash_demo.as_of a)))",
