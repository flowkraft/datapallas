      {
        "id": "w-dd15-chart-waterfall-mrr-movement",
        "type": "chart",
        "gridPosition": {
          "x": 0,
          "y": 4,
          "w": 8,
          "h": 5
        },
        "dataSource": {
          "mode": "sql",
          "visualQuery": {
            "kind": "table",
            "table": "subscription_changes",
            "tableSchema": "dash_demo",
            "filters": [],
            "summarize": [],
            "groupBy": [],
            "sort": [],
            "limit": 500
          },
          "sql": "SELECT CASE ch.change_type\n         WHEN 'new' THEN 'New'\n         WHEN 'expansion' THEN 'Expansion'\n         WHEN 'reactivation' THEN 'Reactivation'\n         WHEN 'contraction' THEN 'Contraction'\n         ELSE 'Churn' END AS movement,\n       round(sum(ch.mrr_delta), 2) AS mrr_delta\nFROM dash_demo.subscription_changes ch\nJOIN dash_demo.subscriptions s ON s.subscription_id = ch.subscription_id\nWHERE ch.change_date > (SELECT a.as_of FROM dash_demo.as_of a) - INTERVAL 12 MONTH\n  AND s.plan IN (${plan})\nGROUP BY movement\nORDER BY CASE movement\n           WHEN 'New' THEN 1\n           WHEN 'Expansion' THEN 2\n           WHEN 'Reactivation' THEN 3\n           WHEN 'Contraction' THEN 4\n           ELSE 5 END",
          "executeVersion": 1
        },
        "displayConfig": {
