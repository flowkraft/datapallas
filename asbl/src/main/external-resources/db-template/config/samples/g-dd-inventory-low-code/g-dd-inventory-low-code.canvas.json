            "table": "stock_levels",
            "tableSchema": "dash_demo",
            "filters": [],
            "summarize": [],
            "groupBy": [],
            "sort": [],
            "limit": 500
          },
          "sql": "SELECT w.name AS warehouse,\n       round(100.0 * sum(sl.qty_on_hand) / max(w.capacity_units), 2) AS capacity_pct\nFROM dash_demo.stock_levels sl\nJOIN dash_demo.warehouses w ON w.warehouse_id = sl.warehouse_id\nWHERE true\n  AND w.name = ${warehouse}\nGROUP BY w.name\nORDER BY capacity_pct DESC",
          "executeVersion": 1
        },
