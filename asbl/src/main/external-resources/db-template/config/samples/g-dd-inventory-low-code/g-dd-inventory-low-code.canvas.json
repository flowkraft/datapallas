        "id": "w-dd19-kpi-skus-below-reorder",
        "type": "number",
        "gridPosition": {
          "x": 4,
          "y": 1,
          "w": 4,
          "h": 2
        },
        "dataSource": {
          "mode": "visual",
          "visualQuery": {
            "kind": "cube",
            "cubeId": "dd-inventory",
            "table": "",
            "filters": [],
            "summarize": [],
            "groupBy": [],
            "sort": [],
            "limit": 500,
            "cubeSelection": {
              "dimensions": [],
              "measures": [
                "BelowReorder"
              ],
              "segments": [],
              "filters": [],
              "granularities": {},
              "order": [],
              "limit": null,
              "paramBindings": [
                {
                  "param": "warehouse",
                  "member": "Warehouse",
                  "operator": "equals"
                },
                {
                  "param": "category",
                  "member": "Category",
                  "operator": "in"
                }
              ]
            }
          },
          "generatedSql": "SELECT\n  COUNT(CASE WHEN (stock.qty_on_hand < stock.reorder_level) THEN 1 END) AS \"BelowReorder\"\nFROM (SELECT l.*, p.unit_cost\n  FROM dash_demo.stock_levels l\n  LEFT JOIN dash_demo.products p ON p.product_id = l.product_id) stock\nLEFT JOIN dash_demo.products ON stock.product_id = dash_demo.products.product_id\nLEFT JOIN dash_demo.warehouses ON stock.warehouse_id = dash_demo.warehouses.warehouse_id\nWHERE dash_demo.warehouses.name = ${warehouse}\n  AND dash_demo.products.category IN (${category})"
        },
        "displayConfig": {
          "numberField": "BelowReorder",
          "_auto_numberField": true,
          "numberFormat": "number",
          "_auto_numberFormat": true,
          "userPicked": true,
          "numberLabel": "SKUs below reorder level"
        },
        "columns": [],
        "shape": {
          "dims": [],
          "measures": []
        }
      },
      {
        "id": "w-dd19-kpi-slow-mover-value",
        "type": "number",
        "gridPosition": {
          "x": 8,
          "y": 1,
          "w": 4,
          "h": 2
        },
        "dataSource": {
          "mode": "sql",
          "visualQuery": {
            "kind": "table",
            "table": "stock_levels",
            "tableSchema": "dash_demo",
            "filters": [],
            "summarize": [],
            "groupBy": [],
            "sort": [],
            "limit": 500
          },
          "sql": "SELECT round(sum(sl.qty_on_hand * pr.unit_cost), 2) AS slow_mover_value\nFROM dash_demo.stock_levels sl\nJOIN dash_demo.products pr ON pr.product_id = sl.product_id\nJOIN dash_demo.warehouses w ON w.warehouse_id = sl.warehouse_id\nWHERE true\n  AND w.name = ${warehouse}\n  AND pr.category IN (${category})\n  AND (sl.last_sold_date IS NULL OR sl.last_sold_date < (SELECT a.as_of FROM dash_demo.as_of a) - INTERVAL 90 DAY)",
          "executeVersion": 1
        },
        "displayConfig": {
