      {
        "id": "w-dd19-chart-space-used-by-warehouse",
        "type": "chart",
        "gridPosition": {
          "x": 0,
          "y": 3,
          "w": 6,
          "h": 5
        },
        "dataSource": {
          "mode": "sql",
          "visualQuery": {
