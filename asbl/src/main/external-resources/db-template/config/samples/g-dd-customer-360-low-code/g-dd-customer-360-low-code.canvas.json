            "filters": [],
            "summarize": [],
            "groupBy": [],
            "sort": [],
            "limit": 500
          },
          "sql": "SELECT p.category AS category,\n       round(sum(l.line_amount), 2) AS spend\nFROM dash_demo.order_lines l\nJOIN dash_demo.orders o ON o.order_id = l.order_id\nJOIN dash_demo.products p ON p.product_id = l.product_id\nWHERE o.status <> 'cancelled'\n  AND o.customer_id = ${customerId}\nGROUP BY 1\nORDER BY spend DESC",
          "executeVersion": 1
        },
