      {
        "id": "w-dd22-progress-team-sla",
        "type": "progress",
        "gridPosition": {
          "x": 4,
          "y": 1,
          "w": 4,
          "h": 3
        },
        "dataSource": {
          "mode": "sql",
          "visualQuery": {
            "kind": "table",
            "table": "kpi_targets",
            "tableSchema": "dash_demo",
            "filters": [],
            "summarize": [],
            "groupBy": [],
            "sort": [],
            "limit": 500
          },
          "sql": "SELECT round(count(CASE WHEN NOT t.sla_breached THEN 1 END) / count(*)::DOUBLE\n             * 100.0 / (SELECT k.target FROM dash_demo.kpi_targets k WHERE k.area = 'Support' AND k.kpi = 'sla_met'), 4) AS pct_of_target\nFROM dash_demo.support_tickets t\nWHERE true\n  AND t.opened_ts >= ${dateFrom}\n  AND t.opened_ts < ${dateTo__next_day}\n  AND t.agent_id IN (SELECT sa.agent_id FROM dash_demo.support_agents sa WHERE sa.team = ${team})",
          "executeVersion": 1
        },
        "displayConfig": {
          "dslConfig": {
            "layout": "fitColumns",
            "autoColumns": true
          },
          "field": "pct_of_target",
          "_auto_field": true,
