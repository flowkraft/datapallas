<?xml version="1.0"?>
<!-- PMD ruleset (PMD 7 rule names) with only the complexity and size rules: cyclomatic, cognitive, NPath, NCSS (long methods and classes) and GodClass.
     Used by `mvn pmd:pmd` in asbl/ci/dp-ci.sh quality. Report only; the thresholds are the rules' defaults, to be tuned by the owner. Nothing here finds bugs
     (that is SpotBugs) or style problems. -->
<ruleset name="DataPallas complexity" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>Complexity and size only</description>
  <rule ref="category/java/design.xml/CyclomaticComplexity"/>
  <rule ref="category/java/design.xml/CognitiveComplexity"/>
  <rule ref="category/java/design.xml/NPathComplexity"/>
  <rule ref="category/java/design.xml/NcssCount"/>
  <rule ref="category/java/design.xml/GodClass"/>
</ruleset>
