        "tableSchema": "cube_demo",
        "filters": [{ "column": "issue_date", "operator": "between", "value": "2025-01-01", "valueTo": "2025-01-08" }],
        "summarize": [{ "aggregation": "COUNT", "field": "*" }],
        "groupBy": [],
        "sort": [],
        "limit": 0
      },
      "columnKinds": { "issue_date": "date" },
      "temporalColumns": ["issue_date"],
      "rows": [[18]]
    },
    {
