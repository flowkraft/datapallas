    "source": "SELECT p.category,\n       SUM(l.qty) AS units,\n       ROUND(SUM(l.qty * l.unit_price * (100 - l.discount_pct) / 100.0), 2) AS net_sales,\n       ROUND(SUM(l.qty * p.cost_price), 2) AS cost_of_goods,\n       ROUND(SUM(l.qty * l.unit_price * (100 - l.discount_pct) / 100.0)\n             - SUM(l.qty * p.cost_price), 2) AS gross_margin,\n       ROUND(1 - SUM(l.qty * p.cost_price)\n                 / SUM(l.qty * l.unit_price * (100 - l.discount_pct) / 100.0), 4) AS margin,\n       ROUND(SUM(l.qty * l.unit_price * l.discount_pct / 100.0)\n             / SUM(l.qty * l.unit_price), 4) AS discount_rate\nFROM cube_demo.shop_order_lines l\nJOIN cube_demo.shop_orders o ON o.order_id = l.order_id\nJOIN cube_demo.shop_products p ON p.product_id = l.product_id\nWHERE o.status NOT IN ('Cancelled','Returned')\nGROUP BY 1\nORDER BY net_sales DESC"
