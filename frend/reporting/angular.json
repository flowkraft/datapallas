{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": false,
    "schematicCollections": [
      "@angular-eslint/schematics"
    ]
  },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "angular-electron": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "schematics": {
        "@schematics/angular:application": {
          "strict": true
        },
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": { "base": "dist", "browser": "" },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "src/tsconfig.app.json",
            "polyfills": ["src/polyfills.ts"],
            "inlineStyleLanguage": "scss",
            "assets": ["src/favicon.ico", "src/assets"],
            "allowedCommonJsDependencies": [
              "rxjs",
              "rxjs/operators",
              "quill",
              "lodash",
              "dayjs",
              "semver",
              "stack-utils",
              "feedparser-promised",
              "xml2js",
              "stompjs",
              "sockjs-client",
              "prismjs",
              "assert"
            ],
            "styles": [
              "src/styles.scss",
              "src/tailwind.source.css",
              "./node_modules/@fontsource/cormorant-garamond/700.css",
              "./node_modules/@fontsource/cormorant-garamond/700-italic.css",
              "./node_modules/quill/dist/quill.core.css",
              "./node_modules/quill/dist/quill.snow.css",
              "./node_modules/quill/dist/quill.bubble.css",
              "./node_modules/prismjs/themes/prism.css",
              "./node_modules/codejar-linenumbers/es/codejar-linenumbers.css"
            ],
            "scripts": [
              "./node_modules/marked/marked.min.js"
            ],
            "externalDependencies": ["electron"]
          },
          "configurations": {
            "dev": {
              "optimization": false,
              "outputHashing": "none",
              "sourceMap": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.dev.ts"
                }
              ]
            },
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            },
            "web": {
              "optimization": false,
              "outputHashing": "none",
              "sourceMap": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.web.ts"
                },
                {
                  "replace": "src/app/areas/electron-nodejs/electron-nodejs.barrel.ts",
                  "with": "src/app/areas/electron-nodejs/electron-nodejs.barrel.empty-web.ts"
                },
                {
                  "replace": "src/app/areas/electron-nodejs/electron.service.ts",
                  "with": "src/app/areas/electron-nodejs/electron.service.empty-web.ts"
                }
              ]
            },
            "web-production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.web.prod.ts"
                },
                {
                  "replace": "src/app/areas/electron-nodejs/electron-nodejs.barrel.ts",
                  "with": "src/app/areas/electron-nodejs/electron-nodejs.barrel.empty-web.ts"
                },
                {
                  "replace": "src/app/areas/electron-nodejs/electron.service.ts",
                  "with": "src/app/areas/electron-nodejs/electron.service.empty-web.ts"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.js",
            "buildTarget": "angular-electron:build"
          },
          "configurations": {
            "dev": {
              "buildTarget": "angular-electron:build:dev"
            },
            "production": {
              "buildTarget": "angular-electron:build:production"
            },
            "web": {
              "buildTarget": "angular-electron:build:web"
            },
            "web-production": {
              "buildTarget": "angular-electron:build:web-production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "angular-electron:build"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"],
            "maxWarnings": -1
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "angular-electron:build",
            "compodoc": true,
            "compodocArgs": ["-e", "json", "-d", "."],
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "angular-electron:build",
            "compodoc": true,
            "compodocArgs": ["-e", "json", "-d", "."],
            "outputDir": "dist/storybook/angular-electron"
          }
        }
      }
    },
    "angular-electron-e2e": {
      "root": "e2e",
      "projectType": "application",
      "architect": {
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["e2e/**/*.ts"]
          }
        }
      }
    }
  }
}
